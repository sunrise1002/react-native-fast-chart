{
  "name": "react-native-fast-chart",
  "version": "0.1.0",
  "description": "High-performance candlestick trading chart for React Native built on Skia, Reanimated and Gesture Handler",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native-fast-chart-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./testing": {
      "react-native-fast-chart-source": "./src/testing/index.ts",
      "types": "./lib/typescript/src/testing/index.d.ts",
      "default": "./lib/module/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-fast-chart-example",
    "clean": "del-cli lib coverage",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "bench": "node --experimental-transform-types --no-warnings --import ./benchmarks/register.mjs benchmarks/run.ts",
    "bench:skia": "node --experimental-transform-types --no-warnings --import ./benchmarks/register.mjs benchmarks/skia.bench.ts"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "chart",
    "candlestick",
    "trading",
    "skia",
    "reanimated",
    "ohlc",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunrise1002/react-native-fast-chart.git"
  },
  "author": "sunrise1002 <tunglm.mar@gmail.com> (https://github.com/sunrise1002)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sunrise1002/react-native-fast-chart/issues"
  },
  "homepage": "https://github.com/sunrise1002/react-native-fast-chart#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@shopify/react-native-skia": "2.6.2",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.6.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-fast-chart-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@shopify/react-native-skia$": "<rootDir>/jest/mocks/react-native-skia.tsx"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/index.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ],
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setupAfterEnv.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native(-[a-z-]+)?|@react-native(-community)?|@shopify/react-native-skia)/)"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  }
}
